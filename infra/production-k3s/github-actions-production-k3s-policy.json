{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProductionFoundationBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:ListBucket",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::capitonic-polybot-tfstate-192200846560-euw1",
        "arn:aws:s3:::capitonic-polybot-backups-192200846560-euw1"
      ]
    },
    {
      "Sid": "ProductionEcrFoundation",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:PutImageTagMutability"
      ],
      "Resource": [
        "arn:aws:ecr:eu-west-1:192200846560:repository/capitonic/polymarket-bot",
        "arn:aws:ecr:eu-west-1:192200846560:repository/capitonic/ingester",
        "arn:aws:ecr:eu-west-1:192200846560:repository/capitonic/db-migrate"
      ]
    },
    {
      "Sid": "ProductionDataVolume",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachVolume",
        "ec2:CreateTags",
        "ec2:CreateVolume",
        "ec2:DeleteTags",
        "ec2:DeleteVolume",
        "ec2:DetachVolume",
        "ec2:ModifyVolume"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "ReadProductionArm64AmiParameter",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:eu-west-1::parameter/aws/service/canonical/ubuntu/server/24.04/stable/current/arm64/hvm/ebs-gp3/ami-id"
    }
  ]
}
