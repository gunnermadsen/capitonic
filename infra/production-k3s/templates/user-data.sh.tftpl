#!/usr/bin/env bash
set -euo pipefail
set +x

exec > >(tee -a /var/log/capitonic-bootstrap.log | logger -t capitonic-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive
AWS_REGION='${aws_region}'
APP_DIRECTORY='${app_directory}'
APP_SECRET_NAME='${app_secret_name}'
ECR_REGISTRY='${ecr_registry}'
K3S_VERSION='${k3s_version}'
REPO_BRANCH='${repo_branch}'
REPO_URL='${repo_url}'

cat >/etc/apt/apt.conf.d/99-capitonic-network <<'APT'
Acquire::ForceIPv4 "true";
APT
sed -i 's|http://|https://|g' /etc/apt/sources.list 2>/dev/null || true
sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true

apt-get update
apt-get install -y --no-install-recommends ca-certificates curl git jq unzip xfsprogs

if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install --update
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi

systemctl enable --now amazon-ssm-agent.service 2>/dev/null || true
systemctl disable --now ssh.service ssh.socket 2>/dev/null || true
systemctl mask ssh.service ssh.socket 2>/dev/null || true

data_device=""
for attempt in $(seq 1 120); do
  root_source="$(findmnt -n -o SOURCE /)"
  root_parent="$(lsblk -no PKNAME "$root_source" 2>/dev/null || true)"
  data_device="$(lsblk -dpno NAME,TYPE | awk -v root="/dev/$root_parent" '$2 == "disk" && $1 != root {print $1; exit}')"
  [ -n "$data_device" ] && break
  sleep 2
done
[ -n "$data_device" ] || { echo "Attached k3s data volume was not discovered." >&2; exit 1; }

if ! blkid "$data_device" >/dev/null 2>&1; then
  mkfs.xfs -f "$data_device"
fi
data_uuid="$(blkid -s UUID -o value "$data_device")"
install -d -m 0755 /var/lib/rancher
grep -q "UUID=$data_uuid" /etc/fstab || printf 'UUID=%s /var/lib/rancher xfs defaults,nofail 0 2\n' "$data_uuid" >>/etc/fstab
mount /var/lib/rancher

curl -sfL https://get.k3s.io | \
  INSTALL_K3S_VERSION="$K3S_VERSION" \
  INSTALL_K3S_EXEC='server --secrets-encryption --write-kubeconfig-mode=0600 --kubelet-arg=image-gc-high-threshold=75 --kubelet-arg=image-gc-low-threshold=65' \
  sh -

for attempt in $(seq 1 120); do
  /usr/local/bin/kubectl get node >/dev/null 2>&1 && break
  sleep 2
done
/usr/local/bin/kubectl wait --for=condition=Ready node --all --timeout=5m

helm_version='v3.18.6'
curl -fsSL "https://get.helm.sh/helm-$helm_version-linux-arm64.tar.gz" -o /tmp/helm.tar.gz
tar -xzf /tmp/helm.tar.gz -C /tmp
install -m 0755 /tmp/linux-arm64/helm /usr/local/bin/helm
rm -rf /tmp/linux-arm64 /tmp/helm.tar.gz

install -d -m 0700 /run/capitonic
secret_file=/run/capitonic/secret.json
aws secretsmanager get-secret-value \
  --region "$AWS_REGION" \
  --secret-id "$APP_SECRET_NAME" \
  --query SecretString \
  --output text >"$secret_file"
chmod 0600 "$secret_file"
jq -e 'type == "object"' "$secret_file" >/dev/null

github_username="$(jq -r '.GITHUB_USERNAME // empty' "$secret_file")"
github_pat="$(jq -r '.GITHUB_PAT // empty' "$secret_file")"
[ -n "$github_username" ] && [ -n "$github_pat" ] || {
  echo "GITHUB_USERNAME and GITHUB_PAT are required for the private deployment checkout." >&2
  exit 1
}
credential_file=/run/capitonic/git-credentials
printf 'https://%s:%s@github.com\n' "$github_username" "$github_pat" >"$credential_file"
chmod 0600 "$credential_file"
rm -rf "$APP_DIRECTORY"
git -c credential.helper="store --file=$credential_file" clone --branch "$REPO_BRANCH" "$REPO_URL" "$APP_DIRECTORY"
rm -f "$credential_file" "$secret_file"
chown -R root:root "$APP_DIRECTORY"
chmod -R go-w "$APP_DIRECTORY"

cat >/etc/systemd/system/capitonic-ecr-secret.service <<UNIT
[Unit]
Description=Refresh the Capitonic Kubernetes ECR pull secret
After=k3s.service network-online.target
Requires=k3s.service

[Service]
Type=oneshot
Environment=AWS_REGION=$AWS_REGION
Environment=ECR_REGISTRY=$ECR_REGISTRY
ExecStart=$APP_DIRECTORY/scripts/production/refresh-ecr-pull-secret.sh
UNIT

cat >/etc/systemd/system/capitonic-ecr-secret.timer <<'UNIT'
[Unit]
Description=Refresh the Capitonic ECR pull secret every six hours

[Timer]
OnBootSec=2min
OnUnitActiveSec=6h
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now capitonic-ecr-secret.timer

apt-get clean
rm -rf /var/lib/apt/lists/*
touch /var/lib/capitonic-bootstrap-complete
