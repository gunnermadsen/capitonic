{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {"id": 1, "type": "stat", "title": "Reconciliation Entry Safety", "description": "Latest process-scoped reconciliation evidence only. Submission-risk evidence is shown separately below.", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_live_reconciliation_entry_safe{process_id=~\"$process_id\"}", "legendFormat": "{{process_id}}"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "BLOCKED", "color": "red"}, "1": {"text": "CLEAN", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 2, "type": "stat", "title": "Reconciliation In Progress", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_live_reconciliation_in_progress{process_id=~\"$process_id\"}", "legendFormat": "{{process_id}}"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "IDLE", "color": "green"}, "1": {"text": "RUNNING", "color": "blue"}}}]}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 3, "type": "stat", "title": "User Stream Heartbeat Age", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "time() - polymarket_live_user_ws_last_pong_timestamp_seconds", "legendFormat": "heartbeat age"}], "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 120}]}}, "overrides": []}, "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 4, "type": "stat", "title": "HTTP Success Age", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "time() - polymarket_live_reconciliation_last_success_timestamp_seconds{process_id=~\"$process_id\"}", "legendFormat": "{{process_id}}"}], "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 120}]}}, "overrides": []}, "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 5, "type": "timeseries", "title": "Reconciliation Latency by Source", "description": "p50 and p95 process-scoped reconciliation duration. Inference scheduling is independent of these runs.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (process_id, source, le) (rate(polymarket_live_reconciliation_duration_seconds_bucket{process_id=~\"$process_id\"}[5m])))", "legendFormat": "p50 {{source}} {{process_id}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (process_id, source, le) (rate(polymarket_live_reconciliation_duration_seconds_bucket{process_id=~\"$process_id\"}[5m])))", "legendFormat": "p95 {{source}} {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}},
    {"id": 6, "type": "timeseries", "title": "Runs and Failures", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (process_id, source, outcome) (rate(polymarket_live_reconciliation_runs_total{process_id=~\"$process_id\"}[5m]))", "legendFormat": "{{source}} / {{outcome}} / {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "bars", "fillOpacity": 55, "stacking": {"mode": "normal", "group": "runs"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}}},
    {"id": 7, "type": "timeseries", "title": "Integrity State", "description": "Latest mismatches and unresolved orders. Nonzero values remain actionable even when transport is healthy.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_live_reconciliation_mismatches{process_id=~\"$process_id\"}", "legendFormat": "mismatches {{process_id}}"}, {"refId": "B", "expr": "polymarket_live_reconciliation_unresolved_orders{process_id=~\"$process_id\"}", "legendFormat": "unresolved {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 18}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}},
    {"id": 8, "type": "timeseries", "title": "Fallback and WebSocket Recovery Evidence", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (process_id, reason) (increase(polymarket_live_reconciliation_fallback_activations_total{process_id=~\"$process_id\"}[15m]))", "legendFormat": "fallback {{reason}} {{process_id}}"}, {"refId": "B", "expr": "sum by (process_id) (increase(polymarket_live_reconciliation_fills_recovered_http_total{process_id=~\"$process_id\"}[15m]))", "legendFormat": "HTTP recovered fills {{process_id}}"}, {"refId": "C", "expr": "increase(polymarket_live_user_ws_queue_overflows_total[15m])", "legendFormat": "WS queue overflow"}, {"refId": "D", "expr": "polymarket_live_reconciliation_last_recovery_duration_seconds{process_id=~\"$process_id\"}", "legendFormat": "last recovery duration {{process_id}}"}, {"refId": "E", "expr": "sum by (process_id, eligibility) (increase(polymarket_live_reconciliation_entry_eligibility_changes_total{process_id=~\"$process_id\"}[15m]))", "legendFormat": "entry {{eligibility}} {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "bars", "fillOpacity": 45}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}}},
    {"id": 9, "type": "timeseries", "title": "Live Order Latency", "description": "Independent p50 and p95 latency stages. No quantiles are added together.", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 21}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (process_id, stage, le) (rate(polymarket_umr_stage_duration_seconds_bucket{process_id=~\"$process_id\",stage=~\"decision_to_venue_post|venue_post_to_acknowledgement|decision_to_venue_acknowledgement\"}[5m])))", "legendFormat": "p50 {{stage}} {{process_id}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (process_id, stage, le) (rate(polymarket_umr_stage_duration_seconds_bucket{process_id=~\"$process_id\",stage=~\"decision_to_venue_post|venue_post_to_acknowledgement|decision_to_venue_acknowledgement\"}[5m])))", "legendFormat": "p95 {{stage}} {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}},
    {"id": 10, "type": "timeseries", "title": "Primary Execution vs Stress Preview", "description": "Primary execution latency remains independent from non-mutating preview completion.", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 21}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (process_id, stage, le) (rate(polymarket_umr_stage_duration_seconds_bucket{process_id=~\"$process_id\",stage=~\"primary_execution|decision_to_primary_execution_result|stress_preview_batch\"}[5m])))", "legendFormat": "p95 {{stage}} {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}},
    {"id": 11, "type": "timeseries", "title": "Candidate Evaluation Lag", "description": "Delay from the scheduled candidate timestamp to actual evaluation; sustained growth represents opportunity loss risk.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (process_id, le) (rate(polymarket_umr_stage_duration_seconds_bucket{process_id=~\"$process_id\",stage=\"scheduled_candidate_evaluation_lag\"}[5m])))", "legendFormat": "p50 {{process_id}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (process_id, le) (rate(polymarket_umr_stage_duration_seconds_bucket{process_id=~\"$process_id\",stage=\"scheduled_candidate_evaluation_lag\"}[5m])))", "legendFormat": "p95 {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}},
    {"id": 12, "type": "timeseries", "title": "Primary Execution Outcomes", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (process_id, reason) (increase(polymarket_umr_execution_outcomes_total{process_id=~\"$process_id\"}[15m]))", "legendFormat": "{{reason}} {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "bars", "fillOpacity": 55, "stacking": {"mode": "normal", "group": "outcomes"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}}},
    {"id": 13, "type": "timeseries", "title": "Qualified Decisions Without a POST", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 38}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (process_id, reason) (increase(polymarket_umr_qualified_without_post_total{process_id=~\"$process_id\"}[15m]))", "legendFormat": "qualified/no POST {{reason}} {{process_id}}"}, {"refId": "B", "expr": "sum by (process_id, reason) (increase(polymarket_umr_pre_submit_gate_rejections_total{process_id=~\"$process_id\"}[15m]))", "legendFormat": "gate {{reason}} {{process_id}}"}, {"refId": "C", "expr": "sum by (process_id, reason) (increase(polymarket_umr_scheduled_buckets_skipped_total{process_id=~\"$process_id\"}[15m]))", "legendFormat": "skipped {{reason}} {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "bars", "fillOpacity": 45}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}}},
    {"id": 14, "type": "timeseries", "title": "Stress Preview Health", "description": "Preview work is bounded and cannot apply backpressure to primary execution.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 38}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_umr_stress_preview_in_flight{process_id=~\"$process_id\"}", "legendFormat": "in flight {{process_id}}"}, {"refId": "B", "expr": "sum by (process_id, reason) (increase(polymarket_umr_stress_preview_outcomes_total{process_id=~\"$process_id\"}[15m]))", "legendFormat": "{{reason}} {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 16}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"]}, "tooltip": {"mode": "multi"}}},
    {"id": 15, "type": "stat", "title": "Actionable Stale Settlements", "description": "Filled orders whose official resolution, local projection, durable watch, or settlement ledger is incomplete. Paper pending credits are actionable; live winners awaiting proven redemption are excluded.", "gridPos": {"h": 5, "w": 12, "x": 0, "y": 46}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_umr_settlement_actionable_stale_fills{process_id=~\"$process_id\"}", "legendFormat": "{{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 16, "type": "stat", "title": "Oldest Actionable Settlement Age", "description": "Age since market close for the oldest settlement that the process must still repair.", "gridPos": {"h": 5, "w": 12, "x": 12, "y": 46}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_umr_settlement_oldest_actionable_stale_age_seconds{process_id=~\"$process_id\"}", "legendFormat": "{{process_id}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 120}, {"color": "red", "value": 300}]}}, "overrides": []}, "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull", "max"], "values": false}}},
    {"id": 17, "type": "timeseries", "title": "Settlement Resolution Pipeline", "description": "Exact incomplete stage for each process-owned filled order after market close.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 51}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_umr_settlement_resolution_missing{process_id=~\"$process_id\"}", "legendFormat": "resolution missing {{process_id}}"}, {"refId": "B", "expr": "polymarket_umr_settlement_projection_missing{process_id=~\"$process_id\"}", "legendFormat": "projection missing {{process_id}}"}, {"refId": "C", "expr": "polymarket_umr_settlement_watch_missing{process_id=~\"$process_id\"}", "legendFormat": "watch missing {{process_id}}"}, {"refId": "D", "expr": "polymarket_umr_settlement_ledger_missing{process_id=~\"$process_id\"}", "legendFormat": "ledger missing {{process_id}}"}, {"refId": "E", "expr": "polymarket_umr_settlement_ledger_pending{process_id=~\"$process_id\"}", "legendFormat": "ledger pending {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 14}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}},
    {"id": 18, "type": "timeseries", "title": "Settlement Auto-Healing", "description": "Durable canonical resolution evidence or watches recovered by the process reconciliation loop.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 51}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (process_id, reason) (increase(polymarket_umr_settlement_autoheal_total{process_id=~\"$process_id\"}[30m]))", "legendFormat": "{{reason}} {{process_id}}"}, {"refId": "B", "expr": "polymarket_umr_settlement_prior_run_unresolved{process_id=~\"$process_id\"}", "legendFormat": "prior-run unresolved {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "bars", "fillOpacity": 45}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"]}, "tooltip": {"mode": "multi"}}},
    {"id": 19, "type": "stat", "title": "Submission Risk Evidence", "description": "Result of the most recent qualified live pre-submit evidence check. This is independent from reconciliation safety.", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 59}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_umr_live_submission_risk_evidence_ready{process_id=~\"$process_id\"}", "legendFormat": "{{process_id}}"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "EVIDENCE ERROR", "color": "red"}, "1": {"text": "VALID", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 20, "type": "stat", "title": "Submission Risk Check Age", "description": "Age of the last qualified live pre-submit risk evaluation; absence means no qualified live attempt since process registration.", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 59}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "time() - polymarket_umr_live_submission_risk_last_check_timestamp_seconds{process_id=~\"$process_id\"}", "legendFormat": "{{process_id}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 900}]}}, "overrides": []}, "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 21, "type": "stat", "title": "Daily Resolved Net PnL", "description": "Validated economic PnL by official-resolution UTC day, including winners awaiting redemption without double counting credited settlements.", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 59}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_umr_live_daily_loss_net_pnl_usd{process_id=~\"$process_id\"}", "legendFormat": "{{process_id}}"}], "fieldConfig": {"defaults": {"unit": "currencyUSD", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0}]}}, "overrides": []}, "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 22, "type": "stat", "title": "Daily Loss Headroom", "description": "Distance between validated daily resolved PnL and the configured daily-loss limit at the latest qualified submission.", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 59}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_umr_live_daily_loss_headroom_usd{process_id=~\"$process_id\"}", "legendFormat": "{{process_id}}"}], "fieldConfig": {"defaults": {"unit": "currencyUSD", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 23, "type": "timeseries", "title": "Live Submission Risk Outcomes", "description": "Every qualified live risk check has one bounded outcome and reason before the venue POST.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 64}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (process_id, outcome, reason) (increase(polymarket_umr_live_submission_risk_checks_total{process_id=~\"$process_id\"}[15m]))", "legendFormat": "{{outcome}} / {{reason}} / {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "bars", "fillOpacity": 55, "stacking": {"mode": "normal", "group": "risk"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}}},
    {"id": 24, "type": "timeseries", "title": "Daily PnL Settlement Evidence", "description": "Counts of economically resolved live settlements used by the latest daily-loss calculation, separated from redemption completion.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 64}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_umr_live_daily_loss_pending_redemption_settlements{process_id=~\"$process_id\"}", "legendFormat": "pending redemption {{process_id}}"}, {"refId": "B", "expr": "polymarket_umr_live_daily_loss_credited_settlements{process_id=~\"$process_id\"}", "legendFormat": "credited {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 16}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}},
    {"id": 25, "type": "timeseries", "title": "Live Open Exposure Admission", "description": "Validated unresolved exposure before and after the proposed order. Officially resolved positions are excluded even while redemption remains pending.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 72}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_umr_live_submission_open_exposure_usd{process_id=~\"$process_id\"}", "legendFormat": "open {{process_id}}"}, {"refId": "B", "expr": "polymarket_umr_live_submission_requested_exposure_usd{process_id=~\"$process_id\"}", "legendFormat": "requested {{process_id}}"}, {"refId": "C", "expr": "polymarket_umr_live_submission_resulting_exposure_usd{process_id=~\"$process_id\"}", "legendFormat": "resulting {{process_id}}"}, {"refId": "D", "expr": "polymarket_umr_live_submission_open_notional_headroom_usd{process_id=~\"$process_id\"}", "legendFormat": "headroom {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "currencyUSD", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min"]}, "tooltip": {"mode": "multi"}}},
    {"id": 26, "type": "timeseries", "title": "Open Markets & Pending Redemption", "description": "Open market occupancy before and after the proposed order, plus redemption liquidity state. A pending redemption may be one while open-market count remains zero.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 72}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_umr_live_submission_open_market_count{process_id=~\"$process_id\"}", "legendFormat": "open markets {{process_id}}"}, {"refId": "B", "expr": "polymarket_umr_live_submission_resulting_market_count{process_id=~\"$process_id\"}", "legendFormat": "resulting markets {{process_id}}"}, {"refId": "C", "expr": "polymarket_umr_live_submission_has_unredeemed_settlement{process_id=~\"$process_id\"}", "legendFormat": "pending redemption {{process_id}}"}, {"refId": "D", "expr": "polymarket_umr_live_submission_open_position_headroom{process_id=~\"$process_id\"}", "legendFormat": "position headroom {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min"]}, "tooltip": {"mode": "multi"}}},
    {"id": 27, "type": "stat", "title": "Live Order Path In Flight", "description": "Process-scoped live order invocations that have not reached an explicit terminal outcome. A sustained nonzero value indicates a stuck internal execution stage.", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 80}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "polymarket_live_order_path_in_flight{process_id=~\"$process_id\"}", "legendFormat": "{{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull", "max"], "values": false}}},
    {"id": 28, "type": "stat", "title": "Unclassified Live Path Exits", "description": "Live order-path invocations that exited without a bounded terminal classification. Any nonzero result is an instrumentation or execution-control defect.", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 80}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(polymarket_live_order_path_terminal_outcomes_total{process_id=~\"$process_id\",outcome=\"error\",reason=\"unclassified_exit\"}[$__range])) or vector(0)", "legendFormat": "unclassified", "instant": true}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 29, "type": "stat", "title": "Live Path Activity Age", "description": "Seconds since the most recent internal live-order transition. No data means the process has not qualified a live order since this runtime started.", "gridPos": {"h": 5, "w": 12, "x": 12, "y": 80}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "(time() - polymarket_live_order_path_last_activity_timestamp_seconds{process_id=~\"$process_id\"}) and polymarket_live_order_path_last_activity_timestamp_seconds{process_id=~\"$process_id\"} > 0", "legendFormat": "{{process_id}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "blue", "value": 900}]}}, "overrides": []}, "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}},
    {"id": 30, "type": "timeseries", "title": "Internal Live Order Stage Latency", "description": "p50 and p95 latency for authentication, risk and metadata, order construction, signing, persistence, final guards, venue POST, and total submission. These measurements are local and never perform I/O on the order path.", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 85}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (process_id, stage, le) (rate(polymarket_live_order_path_stage_duration_seconds_bucket{process_id=~\"$process_id\"}[15m])))", "legendFormat": "p50 {{stage}} {{process_id}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (process_id, stage, le) (rate(polymarket_live_order_path_stage_duration_seconds_bucket{process_id=~\"$process_id\"}[15m])))", "legendFormat": "p95 {{stage}} {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}},
    {"id": 31, "type": "timeseries", "title": "Live Order Terminal Outcomes", "description": "Exactly one bounded terminal outcome per live order-path invocation. Venue rejection, local safety rejection, ambiguity, deduplication, acknowledgement, and unclassified errors remain distinct.", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 85}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (process_id, outcome, reason) (increase(polymarket_live_order_path_terminal_outcomes_total{process_id=~\"$process_id\"}[15m]))", "legendFormat": "{{outcome}} / {{reason}} / {{process_id}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "bars", "fillOpacity": 60, "stacking": {"mode": "normal", "group": "terminal"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}}},
